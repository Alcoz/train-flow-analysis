S3_API=
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
REGION_NAME=
BUCKET_NAME=

DUCKDB_PATH=

DAGSTER_POSTGRES_USER=
DAGSTER_POSTGRES_PASSWORD=
# Only used outside docker compose (local `dg dev`); compose uses the dagster_postgres service
DAGSTER_POSTGRES_HOST=
DAGSTER_POSTGRES_DB=

# Alerting (optional: alerts are skipped when empty)
DISCORD_WEBHOOK_URL=
# Healthchecks.io project ping key (Settings > Ping key), not a check URL
HEALTHCHECK_PING_KEY=

# MLflow tracking and model registry on Databricks (delay_prediction)
# Workspace URL, e.g. https://<workspace>.cloud.databricks.com
DATABRICKS_HOST=
# Personal access token (Settings > Developer > Access tokens)
DATABRICKS_TOKEN=
MLFLOW_TRACKING_URI=databricks
# Unity Catalog registry: models are named <catalog>.<schema>.<model>
MLFLOW_REGISTRY_URI=databricks-uc
# Workspace path of the experiment, e.g. /Users/<your Databricks login>/delay_prediction
MLFLOW_EXPERIMENT_NAME=
