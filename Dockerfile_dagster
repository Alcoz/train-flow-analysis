FROM python:3.10-slim

# Must match uv.lock: webserver/daemon and the code location share one storage
# schema. tests/test_dockerfile_versions.py fails when they drift apart.
ARG DAGSTER_VERSION=1.13.17
ARG DAGSTER_LIBS_VERSION=0.29.17

RUN pip install --no-cache-dir \
    dagster==${DAGSTER_VERSION} \
    dagster-graphql==${DAGSTER_VERSION} \
    dagster-webserver==${DAGSTER_VERSION} \
    dagster-postgres==${DAGSTER_LIBS_VERSION} \
    dagster-docker==${DAGSTER_LIBS_VERSION}

# Set $DAGSTER_HOME and copy dagster.yaml and workspace.yaml there
ENV DAGSTER_HOME=/opt/dagster/dagster_home/

RUN mkdir -p $DAGSTER_HOME

COPY orchestration-dagster/dagster.yaml orchestration-dagster/workspace.yaml $DAGSTER_HOME

WORKDIR $DAGSTER_HOME